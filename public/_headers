# Response headers on Cloudflare (see wrangler.jsonc). Not served as a page.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

# Styles have a new name whenever they change, so phones can keep them.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=2592000

/icons/*
  Cache-Control: public, max-age=2592000

# The offline helper must always be checked for updates.
/sw.js
  Cache-Control: no-cache

# Social media feed (SOCIAL.md): tell feed readers and Zapier it is RSS.
/feeds/social.xml
  Content-Type: application/rss+xml; charset=utf-8
