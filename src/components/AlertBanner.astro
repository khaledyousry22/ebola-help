---
/**
 * Calm, factual outbreak banner shown on every language page.
 * All content comes from src/data/outbreak.json and the cited sources.
 */
import { OUTBREAK } from '../data/outbreak';
import { SOURCES, sourceVersionFor } from '../data/sources';
import { format, formatDate, formatNumber, getMessages, LOCALES, splitAt, type Locale } from '../i18n';
import { countryName, formatList, languageName } from '../i18n/countries';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const m = getMessages(locale);
const info = LOCALES[locale];
const h = OUTBREAK.headline;
const related = OUTBREAK.countries
  .filter((c) => c.status === 'cases')
  .map((c) => countryName(locale, c.iso));

const figures = format(m.outbreak.figures, {
  cases: formatNumber(locale, h.confirmedCases),
  deaths: formatNumber(locale, h.confirmedDeaths),
  date: formatDate(locale, h.asOf),
});
const relatedText = related.length > 0 ? format(m.outbreak.related, { countries: formatList(locale, related) }) : '';

const source = sourceVersionFor(h.source, locale);
const more = sourceVersionFor(OUTBREAK.moreInformation, locale);
const languageTag = (lang: Locale) => format(m.outbreak.languageTag, { language: languageName(locale, lang) });
const [beforeSource, afterSource] = splitAt(m.outbreak.source, 'source');
---
<aside aria-label={m.outbreak.label} class="border-b border-notice-600/40 bg-notice-50 text-notice-900" data-outbreak-banner>
  <div class="container-page flex gap-3 py-3 text-sm">
    <svg class="mt-0.5 shrink-0" width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
      <circle cx="12" cy="12" r="9" /><path d="M12 8h.01M11 12h1v5h1" />
    </svg>
    <div class="space-y-1">
      <p class="font-bold">{format(m.outbreak.headline, { country: countryName(locale, h.country) })}</p>
      <p>{[figures, relatedText].filter(Boolean).join(info.sentenceGap)}</p>
      <p>
        {beforeSource}<a href={source.url} hreflang={source.lang} class="font-medium text-notice-900">{m.publishers[SOURCES[h.source].publisher]}</a>{source.lang !== locale && `${info.sentenceGap}${languageTag(source.lang)}`}{afterSource}
        <span aria-hidden="true"> · </span>
        <a href={more.url} hreflang={more.lang} class="font-medium text-notice-900">{m.outbreak.moreInfo}</a>{more.lang !== locale && `${info.sentenceGap}${languageTag(more.lang)}`}
      </p>
    </div>
  </div>
</aside>
