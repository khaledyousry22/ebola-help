---
import Icon from './Icon.astro';
import { getMessages, LOCALE_LIST, LOCALES, localePath, stripLocale, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const m = getMessages(locale);
const rest = stripLocale(Astro.url.pathname);
---
<details class="relative" data-menu>
  <summary
    class="flex min-h-11 list-none items-center gap-2 rounded-[0.625rem] border border-brand-200 bg-white px-3 py-2 max-[399px]:px-2.5 text-[0.9375rem] font-semibold text-brand-800 transition-colors hover:border-brand-600 hover:bg-brand-50 [&::-webkit-details-marker]:hidden"
  >
    <Icon name="globe" size={18} />
    <span class="sr-only">{m.a11y.languageMenu}:</span>
    <span class="max-[339px]:sr-only">{LOCALES[locale].nativeName}</span>
    <svg class="max-[399px]:hidden" width="14" height="14" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6" /></svg>
  </summary>
  <ul class="absolute end-0 z-40 mt-2 w-52 overflow-hidden rounded-xl border border-line bg-white py-1 shadow-[var(--shadow-lift)]">
    {
      LOCALE_LIST.map((l) => (
        <li>
          <a
            href={localePath(l.code, rest)}
            lang={l.htmlLang}
            hreflang={l.htmlLang}
            dir={l.dir}
            data-locale={l.code}
            aria-current={l.code === locale ? 'true' : undefined}
            class:list={[
              'block px-4 py-3 text-start text-base no-underline hover:bg-brand-50',
              l.code === locale ? 'bg-brand-50 font-bold text-brand-950' : 'text-ink',
            ]}
          >
            {l.nativeName}
          </a>
        </li>
      ))
    }
  </ul>
</details>
