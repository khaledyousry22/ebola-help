---
/**
 * The Adsterra native banner: a clearly labelled panel of sponsored links.
 * Use it at most once per page (Adsterra fills a single container), and only
 * on pages that allow ads (see ADS in src/config.ts).
 *
 * The script loads only when the reader scrolls near the panel, after the
 * page has finished loading, and never:
 * - when the browser asks to save data or the connection is 2G;
 * - when the device uses a European time zone (consent rules there);
 * - when the script is blocked or no ad is returned (the panel stays hidden).
 */
import { ADSTERRA } from '../config';
import { getMessages, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const m = getMessages(Astro.props.locale);
---
{
  ADSTERRA.enabled && (
    <div data-native-ad-zone>
      <aside aria-label={m.ads.label} class="my-8 border-y border-line py-3" data-native-ad hidden>
        <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-muted">{m.ads.label}</p>
        <div id={ADSTERRA.containerId}></div>
      </aside>
      <script is:inline define:vars={{ src: ADSTERRA.scriptUrl, containerId: ADSTERRA.containerId }}>
        (function () {
          var zone = document.currentScript && document.currentScript.closest('[data-native-ad-zone]');
          if (!zone) return;
          var ad = zone.querySelector('[data-native-ad]');
          var connection = navigator.connection || {};
          if (connection.saveData || /(^|-)2g$/.test(connection.effectiveType || '')) return;
          var zoneName = '';
          try { zoneName = Intl.DateTimeFormat().resolvedOptions().timeZone || ''; } catch (e) {}
          if (/^(Europe\/|Arctic\/Longyearbyen|Atlantic\/(Azores|Madeira|Canary|Faroe|Reykjavik))/.test(zoneName)) return;
          function hide() { ad.hidden = true; }
          function show() {
            ad.hidden = false;
            var script = document.createElement('script');
            script.async = true;
            script.setAttribute('data-cfasync', 'false');
            script.src = src;
            script.onerror = hide;
            document.body.appendChild(script);
            // No ad returned: do not leave an empty labelled box.
            setTimeout(function () {
              var box = document.getElementById(containerId);
              if (!box || box.offsetHeight < 20) hide();
            }, 10000);
          }
          function start() {
            if (!('IntersectionObserver' in window)) return;
            var observer = new IntersectionObserver(function (entries) {
              if (entries.some(function (entry) { return entry.isIntersecting; })) {
                observer.disconnect();
                show();
              }
            }, { rootMargin: '300px 0px' });
            observer.observe(zone);
          }
          function whenIdle() {
            if ('requestIdleCallback' in window) requestIdleCallback(start, { timeout: 3000 });
            else setTimeout(start, 1500);
          }
          if (document.readyState === 'complete') whenIdle();
          else window.addEventListener('load', whenIdle);
        })();
      </script>
    </div>
  )
}
