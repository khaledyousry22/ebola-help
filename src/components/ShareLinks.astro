---
/**
 * Links to share the current page. Plain links: nothing is loaded from the
 * social networks, so they learn nothing unless the reader chooses to share.
 */
import { SITE_URL } from '../config';
import { getMessages, type Locale } from '../i18n';
import { BRAND_ICONS, type BrandName } from '../lib/brand-icons';

interface Props {
  locale: Locale;
  title: string;
}
const { locale, title } = Astro.props;
const m = getMessages(locale);
const url = new URL(Astro.url.pathname, SITE_URL).href;
const q = encodeURIComponent;
// WhatsApp first: it is the most used way to pass on information in the affected countries.
const links: { name: BrandName; href: string }[] = [
  { name: 'WhatsApp', href: `https://api.whatsapp.com/send?text=${q(`${title} ${url}`)}` },
  { name: 'Facebook', href: `https://www.facebook.com/sharer/sharer.php?u=${q(url)}` },
  { name: 'X', href: `https://x.com/intent/post?text=${q(title)}&url=${q(url)}` },
];
---
<section aria-labelledby="share-title" class="no-print" data-share>
  <h2 id="share-title" class="eyebrow !mt-0">{m.share.title}</h2>
  <ul class="mt-3 flex flex-wrap gap-2">
    {
      links.map((link) => (
        <li>
          <a href={link.href} rel="noopener noreferrer" class="btn btn-outline" data-share-link={link.name}>
            <svg aria-hidden="true" viewBox="0 0 24 24" class="size-4 shrink-0 fill-current"><path d={BRAND_ICONS[link.name]} /></svg>
            <span>{link.name}</span>
          </a>
        </li>
      ))
    }
  </ul>
</section>
