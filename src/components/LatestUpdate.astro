---
/** The latest situation update, in short, for the home page. */
import { format, formatDate, getMessages, localePath, type Locale } from '../i18n';
import { getUpdates, isoDay, updatePath } from '../lib/updates';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const m = getMessages(locale);
const [latest] = await getUpdates(locale);
---
{
  latest && (
    <section aria-labelledby="latest-update-title" class="mb-10 rounded-lg border border-brand-100 bg-brand-50 p-5" data-latest-update>
      <p class="text-sm font-semibold uppercase tracking-wide text-brand-700">{m.updates.latest}</p>
      <h2 id="latest-update-title" class="mt-1 text-xl font-bold text-brand-900">
        <a href={localePath(locale, updatePath(latest))}>{latest.data.title}</a>
      </h2>
      <p class="mt-1 text-sm text-muted">
        {format(m.updates.figuresAsOf, { date: formatDate(locale, isoDay(latest.data.figuresAsOf)) })}
      </p>
      <ul class="mt-3 list-disc space-y-1 ps-5">
        {latest.data.keyPoints.map((point) => <li>{point}</li>)}
      </ul>
      <p class="mt-3">
        <a href={localePath(locale, updatePath(latest))} class="font-semibold">{m.updates.readMore}</a>
      </p>
    </section>
  )
}
