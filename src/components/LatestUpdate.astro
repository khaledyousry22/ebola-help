---
/** The latest situation update, in short, for the home page. */
import { format, formatDate, getMessages, localePath, type Locale } from '../i18n';
import { getUpdates, isoDay, updatePath } from '../lib/updates';
import Icon from './Icon.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const m = getMessages(locale);
const [latest] = await getUpdates(locale);
---
{
  latest && (
    <section aria-labelledby="latest-update-title" class="card mt-12 overflow-hidden lg:grid lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]" data-latest-update>
      <div class="bg-brand-50 p-5 sm:p-7">
        <p class="eyebrow">{m.updates.latest}</p>
        <h2 id="latest-update-title" class="mt-2 text-2xl font-extrabold leading-tight tracking-tight text-brand-950 rtl:tracking-normal">
          <a href={localePath(locale, updatePath(latest))} class="text-brand-950">{latest.data.title}</a>
        </h2>
        <p class="mt-2 flex items-center gap-2 text-sm text-muted">
          <Icon name="calendar" size={16} />
          {format(m.updates.figuresAsOf, { date: formatDate(locale, isoDay(latest.data.figuresAsOf)) })}
        </p>
        <p class="mt-5">
          <a href={localePath(locale, updatePath(latest))} class="btn btn-primary">
            {m.updates.readMore}
            <Icon name="arrow-right" size={18} flip />
          </a>
        </p>
      </div>
      <ul class="check-list p-5 sm:p-7">
        {latest.data.keyPoints.map((point) => <li>{point}</li>)}
      </ul>
    </section>
  )
}
