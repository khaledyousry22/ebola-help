---
import { BUILD_TIME, PATREON_URL, SOCIAL_LINKS } from '../config';
import { format, formatDateTime, getMessages, localePath, type Locale } from '../i18n';
import { BRAND_ICONS } from '../lib/brand-icons';
import EmailLink from './EmailLink.astro';
import Icon from './Icon.astro';
import Logo from './Logo.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const m = getMessages(locale);

const siteLinks = [
  { path: '/news/', label: m.home.sections.news.title },
  { path: '/updates/', label: m.home.sections.updates.title },
  { path: '/map/', label: m.home.sections.map.title },
  { path: '/help/', label: m.help.title },
  { path: '/health/', label: m.home.sections.health.title },
];
const aboutLinks = [
  { path: '/about/', label: m.nav.about },
  { path: '/editorial-policy/', label: m.footer.editorial },
  { path: '/privacy/', label: m.footer.privacy },
  { path: '/contact/', label: m.footer.contact },
];
---
<footer class="site-footer mt-16 bg-brand-950 text-[0.9375rem] text-[#c9d9e6]">
  <div class="container-page grid gap-x-10 gap-y-8 py-10 sm:grid-cols-2 lg:grid-cols-[minmax(0,1.6fr)_1fr_1fr] lg:py-12">
    <div class="space-y-3 sm:col-span-2 lg:col-span-1">
      <Logo light />
      <p class="font-semibold text-white" data-disclaimer>{m.footer.disclaimer}</p>
      <p>{m.footer.medical}</p>
      <p><EmailLink text={m.footer.wrongNumber} /></p>
    </div>

    <nav aria-label={m.home.sectionsTitle}>
      <h2 class="footer-heading">{m.home.sectionsTitle}</h2>
      <ul class="mt-3 space-y-1">
        {siteLinks.map((link) => <li><a href={localePath(locale, link.path)} class="footer-link">{link.label}</a></li>)}
      </ul>
    </nav>

    <nav aria-label={m.footer.linksLabel}>
      <h2 class="footer-heading">{m.footer.linksLabel}</h2>
      <ul class="mt-3 space-y-1" data-footer-links>
        {aboutLinks.map((link) => <li><a href={localePath(locale, link.path)} class="footer-link">{link.label}</a></li>)}
      </ul>
    </nav>
  </div>

  <div class="border-t border-white/15">
    <div class="container-page flex flex-col gap-4 py-6 lg:flex-row lg:items-center lg:justify-between">
      <div class="flex flex-wrap items-center gap-x-3 gap-y-2" data-social>
        <span id="footer-follow" class="font-semibold text-white">{m.footer.follow}</span>
        <ul class="flex flex-wrap gap-2" aria-labelledby="footer-follow">
          {SOCIAL_LINKS.map((link) => (
            <li>
              <a href={link.url} rel="me" class="btn btn-ghost" data-social-link>
                <svg aria-hidden="true" viewBox="0 0 24 24" class="size-4 shrink-0 fill-current"><path d={BRAND_ICONS[link.name]} /></svg>
                <span>{link.name}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
      <p>
        <a href={PATREON_URL} class="btn btn-light" data-support-link><Icon name="heart" size={18} class="text-teal-700" />{m.footer.support}</a>
      </p>
    </div>
    <p class="container-page pb-8 text-sm">
      <time datetime={BUILD_TIME.toISOString()}>{format(m.footer.lastUpdated, { date: formatDateTime(locale, BUILD_TIME) })}</time>
    </p>
  </div>
</footer>
