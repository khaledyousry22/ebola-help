---
import { BUILD_TIME } from '../config';
import { format, formatDateTime, getMessages, localePath, type Locale } from '../i18n';
import EmailLink from './EmailLink.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const m = getMessages(locale);
---
<footer class="mt-12 border-t border-line bg-surface py-8 text-sm text-muted">
  <div class="container-page space-y-3">
    <p class="font-semibold text-ink" data-disclaimer>{m.footer.disclaimer}</p>
    <p>{m.footer.medical}</p>
    <p><EmailLink text={m.footer.wrongNumber} /></p>
    <p>
      <time datetime={BUILD_TIME.toISOString()}>{format(m.footer.lastUpdated, { date: formatDateTime(locale, BUILD_TIME) })}</time>
    </p>
    <nav aria-label={m.footer.linksLabel}>
      <ul class="flex flex-wrap gap-x-5 gap-y-2" data-footer-links>
        <li><a href={localePath(locale, '/about/')}>{m.nav.about}</a></li>
        <li><a href={localePath(locale, '/editorial-policy/')}>{m.footer.editorial}</a></li>
        <li><a href={localePath(locale, '/privacy/')}>{m.footer.privacy}</a></li>
        <li><a href={localePath(locale, '/contact/')}>{m.footer.contact}</a></li>
      </ul>
    </nav>
  </div>
</footer>
