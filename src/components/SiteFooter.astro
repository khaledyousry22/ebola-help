---
import { BUILD_TIME, PATREON_URL, SOCIAL_LINKS } from '../config';
import { format, formatDateTime, getMessages, localePath, type Locale } from '../i18n';
import EmailLink from './EmailLink.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const m = getMessages(locale);

// Logos from Simple Icons 15.22.0 (simpleicons.org, CC0), drawn inline: no extra download.
const ICONS: Record<(typeof SOCIAL_LINKS)[number]['name'], string> = {
  X: 'M14.234 10.162 22.977 0h-2.072l-7.591 8.824L7.251 0H.258l9.168 13.343L.258 24H2.33l8.016-9.318L16.749 24h6.993zm-2.837 3.299-.929-1.329L3.076 1.56h3.182l5.965 8.532.929 1.329 7.754 11.09h-3.182z',
  Facebook:
    'M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036 26.805 26.805 0 0 0-.733-.009c-.707 0-1.259.096-1.675.309a1.686 1.686 0 0 0-.679.622c-.258.42-.374.995-.374 1.752v1.297h3.919l-.386 2.103-.287 1.564h-3.246v8.245C19.396 23.238 24 18.179 24 12.044c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.628 3.874 10.35 9.101 11.647Z',
};
---
<footer class="mt-12 border-t border-line bg-surface py-8 text-sm text-muted">
  <div class="container-page space-y-3">
    <p class="font-semibold text-ink" data-disclaimer>{m.footer.disclaimer}</p>
    <p>{m.footer.medical}</p>
    <p><EmailLink text={m.footer.wrongNumber} /></p>
    <p><a href={PATREON_URL} class="font-semibold" data-support-link>{m.footer.support}</a></p>
    <div class="flex flex-wrap items-center gap-x-3 gap-y-2" data-social>
      <span id="footer-follow">{m.footer.follow}</span>
      <ul class="flex flex-wrap gap-2" aria-labelledby="footer-follow">
        {SOCIAL_LINKS.map((link) => (
          <li>
            <a
              href={link.url}
              rel="me"
              class="inline-flex min-h-11 items-center gap-2 rounded-md border border-line bg-white px-3 font-medium text-ink no-underline hover:border-teal-700"
              data-social-link
            >
              <svg aria-hidden="true" viewBox="0 0 24 24" class="size-4 shrink-0 fill-current"><path d={ICONS[link.name]} /></svg>
              <span>{link.name}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
    <p>
      <time datetime={BUILD_TIME.toISOString()}>{format(m.footer.lastUpdated, { date: formatDateTime(locale, BUILD_TIME) })}</time>
    </p>
    <nav aria-label={m.footer.linksLabel}>
      <ul class="flex flex-wrap gap-x-5 gap-y-2" data-footer-links>
        <li><a href={localePath(locale, '/about/')}>{m.nav.about}</a></li>
        <li><a href={localePath(locale, '/editorial-policy/')}>{m.footer.editorial}</a></li>
        <li><a href={localePath(locale, '/privacy/')}>{m.footer.privacy}</a></li>
        <li><a href={localePath(locale, '/contact/')}>{m.footer.contact}</a></li>
      </ul>
    </nav>
  </div>
</footer>
