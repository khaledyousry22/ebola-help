---
import { HELP_COUNTRIES, phoneHref, verifiedPhones } from '../data/help';
import { format, formatDate, getMessages, LOCALES, localePath, type Locale } from '../i18n';
import { countryName } from '../i18n/countries';
import Icon from './Icon.astro';

interface Props {
  locale: Locale;
  /** Full version on the home page; compact elsewhere so page content stays close to the top. */
  full?: boolean;
}
const { locale, full = false } = Astro.props;
const m = getMessages(locale);

// Only numbers the site owner has verified. Calls first, at most two per country.
const countries = HELP_COUNTRIES.map((iso) => ({
  iso,
  name: countryName(locale, iso),
  phones: verifiedPhones(iso)
    .filter((p) => p.channel === 'call')
    .slice(0, 2),
}))
  .filter((c) => c.phones.length > 0)
  .sort((a, b) => a.name.localeCompare(b.name));
---
<section
  aria-labelledby="emergency-title"
  class="card relative overflow-hidden border-teal-200 p-4 ps-5 sm:p-6 sm:ps-7"
  data-emergency-box
>
  <span class="absolute inset-y-0 start-0 w-1.5 bg-teal-700" aria-hidden="true"></span>
  <div class="gap-x-8 gap-y-4 lg:grid lg:grid-cols-[minmax(0,1fr)_21rem] lg:items-start">
    <div class="flex gap-4">
      <span class="icon-chip max-sm:hidden"><Icon name="phone" size={22} /></span>
      <div class="min-w-0">
        <h2 id="emergency-title" class="text-lg font-bold leading-snug text-brand-950 sm:text-xl">{m.emergency.title}</h2>
        <p class="mt-1.5 text-ink">{full ? m.emergency.action : m.emergency.short}</p>
        <details class="mt-1">
          <summary class="min-h-11 py-2.5 font-semibold text-teal-800">{m.emergency.more}</summary>
          {!full && <p class="mt-1 text-ink">{m.emergency.action}</p>}
          <p class="mt-2 text-ink">{m.emergency.symptoms}</p>
          <p class="mt-2 text-ink">{m.emergency.care}</p>
          {countries.length === 0 && <p class="mt-2 text-sm text-muted">{m.emergency.hotlinePending}</p>}
        </details>
      </div>
    </div>

    <div class="max-lg:mt-2">
      {
        countries.length > 0 && (
          <div class="mb-3" data-emergency-picker hidden>
            <label for="emergency-country" class="block text-sm font-semibold text-brand-950">{m.emergency.yourCountry}</label>
            <select id="emergency-country" class="mt-1 min-h-12 w-full rounded-[0.625rem] border border-teal-700 bg-white px-3 text-base font-medium text-ink">
              {/* Nothing is preselected: a number from another country would not work. */}
              <option value="">{m.emergency.chooseCountry}</option>
              {countries.map((c) => <option value={c.iso}>{c.name}</option>)}
            </select>
            {countries.map((c) => (
              <ul class="mt-3 space-y-2" data-emergency-phones={c.iso} hidden>
                {c.phones.map((p) => (
                  <li class="rounded-[0.625rem] bg-teal-50 px-3 py-2">
                    <span class="text-sm font-semibold text-teal-800">{format(m.emergency.numberLabel, { purpose: m.help.purpose[p.purpose] })}</span>{LOCALES[locale].sentenceGap}<a href={phoneHref(p)} class="ltr-data text-xl font-extrabold text-brand-950">{p.display ?? p.number}</a>
                    <span class="block text-xs text-muted">
                      {format(m.help.lastVerified, { date: formatDate(locale, p.verifiedAt!) })} · <a href={p.sourceUrl}>{m.help.source}</a>
                    </span>
                  </li>
                ))}
              </ul>
            ))}
          </div>
        )
      }
      <a href={localePath(locale, '/help/')} class="btn btn-primary w-full text-center">
        {m.emergency.findHelpline}
        <Icon name="arrow-right" size={18} flip />
      </a>
    </div>
  </div>
</section>

{
  countries.length > 0 && (
    <script is:inline>
      (function () {
        var picker = document.querySelector('[data-emergency-picker]');
        if (!picker) return;
        var select = picker.querySelector('select');
        function show(iso) {
          picker.querySelectorAll('[data-emergency-phones]').forEach(function (list) {
            list.hidden = list.getAttribute('data-emergency-phones') !== iso;
          });
        }
        try {
          var saved = localStorage.getItem('ebh_country');
          if (saved && select.querySelector('option[value="' + saved + '"]')) select.value = saved;
        } catch (e) {}
        select.addEventListener('change', function () {
          show(select.value);
          try { localStorage.setItem('ebh_country', select.value); } catch (e) {}
        });
        show(select.value);
        picker.hidden = false;
      })();
    </script>
  )
}
