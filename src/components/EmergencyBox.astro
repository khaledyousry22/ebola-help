---
import { HELP_COUNTRIES, phoneHref, verifiedPhones } from '../data/help';
import { format, formatDate, getMessages, LOCALES, localePath, type Locale } from '../i18n';
import { countryName } from '../i18n/countries';

interface Props {
  locale: Locale;
  /** Full version on the home page; compact elsewhere so page content stays close to the top. */
  full?: boolean;
}
const { locale, full = false } = Astro.props;
const m = getMessages(locale);

// Only numbers the site owner has verified. Calls first, at most two per country.
const countries = HELP_COUNTRIES.map((iso) => ({
  iso,
  name: countryName(locale, iso),
  phones: verifiedPhones(iso)
    .filter((p) => p.channel === 'call')
    .slice(0, 2),
}))
  .filter((c) => c.phones.length > 0)
  .sort((a, b) => a.name.localeCompare(b.name));
---
<section
  aria-labelledby="emergency-title"
  class="rounded-lg border border-teal-100 border-s-4 border-s-teal-700 bg-teal-50 p-4 sm:p-5"
  data-emergency-box
>
  <h2 id="emergency-title" class="text-lg font-bold text-teal-800">
    <svg class="me-2 inline-block align-[-3px]" width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z" />
    </svg>
    {m.emergency.title}
  </h2>
  {
    full ? (
      <p class="mt-2 font-medium text-ink">{m.emergency.action}</p>
    ) : (
      <p class="mt-1 font-medium text-ink">{m.emergency.short}</p>
    )
  }

  {
    countries.length > 0 && (
      <div class="mt-3" data-emergency-picker hidden>
        <label for="emergency-country" class="me-2 text-sm font-semibold text-teal-800">{m.emergency.yourCountry}</label>
        <select id="emergency-country" class="min-h-11 rounded-md border border-teal-700 bg-white px-2">
          {/* Nothing is preselected: a number from another country would not work. */}
          <option value="">{m.emergency.chooseCountry}</option>
          {countries.map((c) => <option value={c.iso}>{c.name}</option>)}
        </select>
        {countries.map((c) => (
          <ul class="mt-2 space-y-2" data-emergency-phones={c.iso} hidden>
            {c.phones.map((p) => (
              <li>
                {format(m.emergency.numberLabel, { purpose: m.help.purpose[p.purpose] })}{LOCALES[locale].sentenceGap}<a href={phoneHref(p)} class="ltr-data text-lg font-bold text-brand-900">{p.display ?? p.number}</a>
                <span class="block text-xs text-muted">
                  {format(m.help.lastVerified, { date: formatDate(locale, p.verifiedAt!) })} · <a href={p.sourceUrl}>{m.help.source}</a>
                </span>
              </li>
            ))}
          </ul>
        ))}
      </div>
    )
  }

  <p class="mt-2">
    <a href={localePath(locale, '/help/')} class="font-semibold text-teal-800">{m.emergency.findHelpline}</a>
  </p>

  <details class="mt-2">
    <summary class="min-h-11 py-2 font-semibold text-teal-800">{m.emergency.more}</summary>
    {!full && <p class="mt-1 text-ink">{m.emergency.action}</p>}
    <p class="mt-2 text-ink">{m.emergency.symptoms}</p>
    <p class="mt-2 text-ink">{m.emergency.care}</p>
    {countries.length === 0 && <p class="mt-2 text-sm text-muted">{m.emergency.hotlinePending}</p>}
  </details>
</section>

{
  countries.length > 0 && (
    <script is:inline>
      (function () {
        var picker = document.querySelector('[data-emergency-picker]');
        if (!picker) return;
        var select = picker.querySelector('select');
        function show(iso) {
          picker.querySelectorAll('[data-emergency-phones]').forEach(function (list) {
            list.hidden = list.getAttribute('data-emergency-phones') !== iso;
          });
        }
        try {
          var saved = localStorage.getItem('ebh_country');
          if (saved && select.querySelector('option[value="' + saved + '"]')) select.value = saved;
        } catch (e) {}
        select.addEventListener('change', function () {
          show(select.value);
          try { localStorage.setItem('ebh_country', select.value); } catch (e) {}
        });
        show(select.value);
        picker.hidden = false;
      })();
    </script>
  )
}
