---
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import EmailLink from '../../../components/EmailLink.astro';
import Icon from '../../../components/Icon.astro';
import StatusBadge from '../../../components/StatusBadge.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getMessages, LOCALE_CODES, localePath, type Locale } from '../../../i18n';
import { countryPath, sortedCountries } from '../../../lib/country-pages';

export function getStaticPaths() {
  return LOCALE_CODES.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const m = getMessages(locale);
const countries = sortedCountries(locale);
---
<BaseLayout locale={locale} title={m.help.title} description={m.help.description}>
  <div slot="intro" class="prose-page">
    <Breadcrumbs locale={locale} items={[{ label: m.nav.home, href: localePath(locale) }, { label: m.help.title }]} />
    <h1 class="page-title">{m.help.title}</h1>
    <p class="page-lead">{m.help.intro}</p>
  </div>

  <section aria-labelledby="countries-title">
    <h2 id="countries-title" class="section-title">{m.help.countriesTitle}</h2>
    <ul class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3" data-country-list>
      {
        countries.map((c) => (
          <li>
            <a href={localePath(locale, countryPath(c.iso))} class="card flex h-full items-center gap-4 p-5" data-country-link={c.iso}>
              <span class="flex min-w-0 flex-1 flex-col items-start gap-2.5">
                <span class="card-title text-lg leading-snug">{c.name}</span>
                <StatusBadge locale={locale} status={c.situation.status} />
              </span>
              <Icon name="chevron-right" size={20} flip class="text-brand-600" />
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section aria-labelledby="symptoms-title" class="paper prose-page mt-10">
    <h2 id="symptoms-title" class="!mt-0">{m.emergency.title}</h2>
    <p>{m.emergency.action}</p>
    <p>{m.emergency.symptoms}</p>
    <p>{m.emergency.care}</p>
  </section>

  <p class="note mt-8 max-w-[46rem]"><EmailLink text={m.help.policy} /></p>
</BaseLayout>
