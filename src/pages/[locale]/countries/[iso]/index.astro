---
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import Icon from '../../../../components/Icon.astro';
import ContactList from '../../../../components/ContactList.astro';
import CountryFigures from '../../../../components/CountryFigures.astro';
import NewsCard from '../../../../components/NewsCard.astro';
import StatusBadge from '../../../../components/StatusBadge.astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { newsForCountry } from '../../../../data/news';
import { countrySituation } from '../../../../data/outbreak';
import { format, getMessages, LOCALE_CODES, localePath, type Locale } from '../../../../i18n';
import { countryName } from '../../../../i18n/countries';
import { COUNTRY_PAGES } from '../../../../lib/country-pages';

export function getStaticPaths() {
  return LOCALE_CODES.flatMap((locale) => COUNTRY_PAGES.map((iso) => ({ params: { locale, iso: iso.toLowerCase() } })));
}

const locale = Astro.params.locale as Locale;
const iso = Astro.params.iso!.toUpperCase();
const m = getMessages(locale);
const name = countryName(locale, iso);
const situation = countrySituation(iso);
const news = newsForCountry(iso, locale).slice(0, 5);
---
<BaseLayout locale={locale} title={format(m.country.metaTitle, { country: name })} description={format(m.country.description, { country: name })}>
  <div slot="intro" class="grid items-center gap-6 lg:grid-cols-[minmax(0,1fr)_24rem] lg:gap-12" data-country-situation>
    <div>
      <Breadcrumbs
        locale={locale}
        items={[
          { label: m.nav.home, href: localePath(locale) },
          { label: m.help.title, href: localePath(locale, '/help/') },
          { label: name },
        ]}
      />
      <h1 class="page-title">{name}</h1>
      <p class="mt-4"><span class="sr-only">{m.country.status}: </span><StatusBadge locale={locale} status={situation.status} /></p>
    </div>
    {
      (situation.figures || situation.endedOn) && (
        <div class="card space-y-3 p-4 sm:p-5">
          <h2 class="eyebrow">{m.country.figures}</h2>
          <CountryFigures locale={locale} situation={situation} tiles />
        </div>
      )
    }
  </div>

  <div class="gap-10 lg:grid lg:grid-cols-[minmax(0,1fr)_24rem]">
    <div>
      <ContactList locale={locale} iso={iso} />
    </div>

    <section aria-labelledby="news-title" class="max-lg:mt-10">
      <h2 id="news-title" class="section-title">{m.country.latestNews}</h2>
      {
        news.length > 0 ? (
          <ul class="card mt-4 divide-y divide-line">
            {news.map((item) => <li><NewsCard item={item} locale={locale} compact /></li>)}
          </ul>
        ) : (
          <p class="mt-3 text-muted">{m.country.noNews}</p>
        )
      }
    </section>
  </div>

  <p class="mt-10"><a href={localePath(locale, '/help/')} class="btn btn-outline">{m.country.allCountries}<Icon name="arrow-right" size={18} flip /></a></p>
</BaseLayout>
