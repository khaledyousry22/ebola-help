---
import EmailLink from '../../../components/EmailLink.astro';
import TextWithLinks from '../../../components/TextWithLinks.astro';
import { ADS, PATREON_URL } from '../../../config';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getMessages, LOCALE_CODES, localePath, type Locale } from '../../../i18n';

export function getStaticPaths() {
  return LOCALE_CODES.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const m = getMessages(locale);
const a = m.about;
const blocks = [
  [a.whatTitle, a.what],
  [a.sourcesTitle, a.sources],
  [a.verificationTitle, a.verification],
  [a.translationTitle, a.translation],
  [a.medicalTitle, a.medical],
] as const;
const policyLinks = [
  { href: localePath(locale, '/editorial-policy/'), label: m.footer.editorial },
  { href: localePath(locale, '/privacy/'), label: m.footer.privacy },
  { href: localePath(locale, '/contact/'), label: m.footer.contact },
];
const privacyLinks = {
  googleUse: { href: 'https://policies.google.com/technologies/partner-sites', label: a.linkGoogleUse },
  adsSettings: { href: 'https://adssettings.google.com/', label: a.linkAdsSettings },
  aboutAds: { href: 'https://www.aboutads.info/', label: 'aboutads.info' },
};
---
<BaseLayout locale={locale} title={m.meta.aboutTitle} description={m.meta.aboutDescription}>
  <h1 slot="intro" class="text-2xl font-bold text-brand-900 sm:text-3xl">{a.heading}</h1>
  <article class="prose-page">

    <section class="rounded-lg border border-notice-600 bg-notice-50 p-4 text-notice-900" data-independence>
      <h2 class="!mt-0 !text-notice-900">{a.independenceTitle}</h2>
      <p class="!mb-0">{a.independence}</p>
    </section>

    <section id="who" data-who>
      <h2>{a.whoTitle}</h2>
      <p>{a.who}</p>
      <ul>
        {policyLinks.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
      </ul>
    </section>

    {
      blocks.map(([heading, text]) => (
        <section>
          <h2>{heading}</h2>
          <p>{text}</p>
        </section>
      ))
    }

    {
      ADS.enabled && (
        <section id="advertising" data-advertising>
          <h2>{a.advertisingTitle}</h2>
          <p>{a.advertising}</p>
        </section>
      )
    }

    <section id="support" data-support>
      <h2>{a.supportTitle}</h2>
      <p><TextWithLinks text={a.support} links={{ patreon: { href: PATREON_URL, label: a.linkPatreon } }} /></p>
    </section>

    <section id="privacy" data-privacy>
      <h2>{a.privacyTitle}</h2>
      <p><TextWithLinks text={a.privacy} links={privacyLinks} /></p>
      <p><a href={localePath(locale, '/privacy/')}>{a.privacyMore}</a></p>
    </section>

    <section>
      <h2>{a.contactTitle}</h2>
      <p><EmailLink text={a.contact} /></p>
    </section>
  </article>
</BaseLayout>
