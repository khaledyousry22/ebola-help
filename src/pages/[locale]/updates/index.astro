---
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import Icon from '../../../components/Icon.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { format, formatDate, getMessages, LOCALE_CODES, localePath, type Locale } from '../../../i18n';
import { getUpdates, isoDay, updatePath } from '../../../lib/updates';

export function getStaticPaths() {
  return LOCALE_CODES.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const m = getMessages(locale);
const updates = await getUpdates(locale);
---
<BaseLayout locale={locale} title={m.updates.metaTitle} description={m.updates.description}>
  <div slot="intro" class="prose-page">
    <Breadcrumbs locale={locale} items={[{ label: m.nav.home, href: localePath(locale) }, { label: m.updates.title }]} />
    <h1 class="page-title">{m.updates.title}</h1>
    <p class="page-lead">{m.updates.intro}</p>
  </div>

  <ol class="max-w-[48rem] space-y-4" data-updates-list>
    {
      updates.map((entry) => (
        <li class="card flex gap-4 p-5 sm:p-6">
          <span class="icon-chip max-sm:hidden"><Icon name="clipboard-list" size={22} /></span>
          <div class="min-w-0">
            <p class="text-sm text-muted">
              <time datetime={isoDay(entry.data.date)}>{format(m.updates.published, { date: formatDate(locale, isoDay(entry.data.date)) })}</time>
              {' · '}
              {format(m.updates.figuresAsOf, { date: formatDate(locale, isoDay(entry.data.figuresAsOf)) })}
            </p>
            <h2 class="mt-1 text-xl font-bold leading-snug">
              <a href={localePath(locale, updatePath(entry))} class="text-brand-800">{entry.data.title}</a>
            </h2>
            <p class="mt-2">{entry.data.description}</p>
          </div>
        </li>
      ))
    }
  </ol>
</BaseLayout>
