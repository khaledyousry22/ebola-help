---
import { render } from 'astro:content';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import SourceList from '../../../../components/SourceList.astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import type { SourceId } from '../../../../data/sources';
import { format, formatDate, getMessages, localePath } from '../../../../i18n';
import { getCollection } from 'astro:content';
import { isoDay, splitUpdateId, type UpdateEntry } from '../../../../lib/updates';

export async function getStaticPaths() {
  const entries = await getCollection('updates');
  return entries.map((entry) => {
    const { locale, slug } = splitUpdateId(entry.id);
    return { params: { locale, slug }, props: { entry } };
  });
}

interface Props {
  entry: UpdateEntry;
}
const { entry } = Astro.props;
const { locale } = splitUpdateId(entry.id);
const m = getMessages(locale);
const { Content } = await render(entry);
const published = isoDay(entry.data.date);
---
<BaseLayout locale={locale} title={entry.data.title} description={entry.data.description}>
  <div slot="intro" class="prose-page">
    <Breadcrumbs
      locale={locale}
      items={[
        { label: m.nav.home, href: localePath(locale) },
        { label: m.updates.title, href: localePath(locale, '/updates/') },
        { label: entry.data.title },
      ]}
    />
    <h1 class="text-2xl font-bold text-brand-900 sm:text-3xl">{entry.data.title}</h1>
    <p class="mt-2 text-sm text-muted">
      <time datetime={published}>{format(m.updates.published, { date: formatDate(locale, published) })}</time>
      {' · '}
      {format(m.updates.figuresAsOf, { date: formatDate(locale, isoDay(entry.data.figuresAsOf)) })}
    </p>
  </div>

  <article class="prose-page">
    <section aria-labelledby="in-short" class="mb-8 rounded-lg border border-brand-100 bg-brand-50 p-5" data-key-points>
      <h2 id="in-short" class="!mt-0 text-lg font-bold text-brand-900">{m.updates.inShort}</h2>
      <ul class="mt-2 list-disc space-y-1 ps-5">
        {entry.data.keyPoints.map((point) => <li>{point}</li>)}
      </ul>
    </section>

    <div class="prose-content">
      <Content />
    </div>

    <p class="mt-8 rounded-lg bg-surface p-4 text-sm text-muted" data-update-disclaimer>{m.updates.disclaimer}</p>

    <SourceList locale={locale} ids={entry.data.sources as SourceId[]} />

    <p class="mt-8"><a href={localePath(locale, '/updates/')} class="font-semibold">{m.updates.all}</a></p>
  </article>
</BaseLayout>
