---
import { render } from 'astro:content';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import Icon from '../../../../components/Icon.astro';
import JsonLd from '../../../../components/JsonLd.astro';
import ShareLinks from '../../../../components/ShareLinks.astro';
import SourceList from '../../../../components/SourceList.astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import type { SourceId } from '../../../../data/sources';
import { SITE_URL } from '../../../../config';
import { format, formatDate, getMessages, LOCALES, localePath } from '../../../../i18n';
import { article } from '../../../../lib/structured-data';
import { getCollection } from 'astro:content';
import { isoDay, splitUpdateId, type UpdateEntry } from '../../../../lib/updates';

export async function getStaticPaths() {
  const entries = await getCollection('updates');
  return entries.map((entry) => {
    const { locale, slug } = splitUpdateId(entry.id);
    return { params: { locale, slug }, props: { entry } };
  });
}

interface Props {
  entry: UpdateEntry;
}
const { entry } = Astro.props;
const { locale } = splitUpdateId(entry.id);
const m = getMessages(locale);
const { Content } = await render(entry);
const published = isoDay(entry.data.date);
---
<BaseLayout locale={locale} title={entry.data.title} description={entry.data.description}>
  <div slot="intro" class="prose-page">
    <Breadcrumbs
      locale={locale}
      items={[
        { label: m.nav.home, href: localePath(locale) },
        { label: m.updates.title, href: localePath(locale, '/updates/') },
        { label: entry.data.title },
      ]}
    />
    <h1 class="page-title">{entry.data.title}</h1>
    <p class="mt-3 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-muted">
      <Icon name="calendar" size={16} />
      <time datetime={published}>{format(m.updates.published, { date: formatDate(locale, published) })}</time>
      <span aria-hidden="true">·</span>
      {format(m.updates.figuresAsOf, { date: formatDate(locale, isoDay(entry.data.figuresAsOf)) })}
    </p>
  </div>

  <div class="gap-10 lg:grid lg:grid-cols-[minmax(0,46rem)_minmax(0,1fr)]">
    <article class="paper prose-page" data-print-main>
      <section aria-labelledby="in-short" class="mb-8 rounded-xl border border-teal-100 bg-teal-50 p-5" data-key-points>
        <h2 id="in-short" class="!mt-0 !mb-3 !text-lg">{m.updates.inShort}</h2>
        <ul class="check-list">
          {entry.data.keyPoints.map((point) => <li>{point}</li>)}
        </ul>
      </section>

      <div class="prose-content">
        <Content />
      </div>

      <p class="note mt-8" data-update-disclaimer>{m.updates.disclaimer}</p>

      <SourceList locale={locale} ids={entry.data.sources as SourceId[]} />
    </article>

    <aside class="no-print max-lg:mt-8">
      <div class="space-y-6 lg:sticky lg:top-6">
        <div class="card p-5">
          <ShareLinks locale={locale} title={entry.data.title} />
        </div>
        <p>
          <a href={localePath(locale, '/updates/')} class="btn btn-outline w-full">{m.updates.all}<Icon name="arrow-right" size={18} flip /></a>
        </p>
      </div>
    </aside>
  </div>
  <JsonLd
    data={article({
      type: 'Article',
      url: new URL(Astro.url.pathname, SITE_URL).href,
      title: entry.data.title,
      description: entry.data.description,
      language: LOCALES[locale].htmlLang,
      image: new URL(`/social/${locale}.png`, SITE_URL).href,
      published,
      modified: published,
    })}
  />
</BaseLayout>
