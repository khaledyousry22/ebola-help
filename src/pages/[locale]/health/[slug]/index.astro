---
import { render } from 'astro:content';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import SourceList from '../../../../components/SourceList.astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import type { SourceId } from '../../../../data/sources';
import { format, formatDate, getMessages, localePath } from '../../../../i18n';
import { getHealthPages, splitHealthId, type HealthEntry } from '../../../../lib/health';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('health');
  return entries.map((entry) => {
    const { locale, slug } = splitHealthId(entry.id);
    return { params: { locale, slug }, props: { entry } };
  });
}

interface Props {
  entry: HealthEntry;
}
const { entry } = Astro.props;
const { locale, slug } = splitHealthId(entry.id);
const m = getMessages(locale);
const { Content } = await render(entry);

const siblings = await getHealthPages(locale);
const index = siblings.findIndex((page) => splitHealthId(page.id).slug === slug);
const prev = siblings[index - 1];
const next = siblings[index + 1];
const pageUrl = (page: HealthEntry) => localePath(locale, `/health/${splitHealthId(page.id).slug}/`);
const reviewed = entry.data.reviewed.toISOString().slice(0, 10);
---
<BaseLayout locale={locale} title={entry.data.title} description={entry.data.description}>
  <div slot="intro" class="prose-page">
    <Breadcrumbs
      locale={locale}
      items={[
        { label: m.nav.home, href: localePath(locale) },
        { label: m.health.hubTitle, href: localePath(locale, '/health/') },
        { label: entry.data.title },
      ]}
    />
    <h1 class="text-2xl font-bold text-brand-900 sm:text-3xl">{entry.data.title}</h1>
    <p class="mt-2 text-sm text-muted">
      <time datetime={reviewed}>{format(m.health.reviewed, { date: formatDate(locale, reviewed) })}</time>
    </p>
  </div>

  <article class="prose-page">
    {
      entry.data.keyPoints.length > 0 && (
        <section aria-labelledby="key-points" class="mb-8 rounded-lg border border-brand-100 bg-brand-50 p-5" data-key-points>
          <h2 id="key-points" class="!mt-0 text-lg font-bold text-brand-900">{m.health.keyPoints}</h2>
          <ul class="mt-2 list-disc space-y-1 ps-5">
            {entry.data.keyPoints.map((point) => <li>{point}</li>)}
          </ul>
        </section>
      )
    }

    <div class="prose-content">
      <Content />
    </div>

    <p class="mt-8 rounded-lg bg-surface p-4 text-sm text-muted" data-medical-disclaimer>{m.health.disclaimer}</p>

    <SourceList locale={locale} ids={entry.data.sources as SourceId[]} />

    <nav aria-label={m.health.hubTitle} class="mt-10 grid gap-3 sm:grid-cols-2">
      {
        prev && (
          <a href={pageUrl(prev)} class="rounded-lg border border-line p-4 no-underline hover:border-brand-600" rel="prev">
            <span class="block text-sm text-muted">{m.health.previous}</span>
            <span class="font-semibold">{prev.data.title}</span>
          </a>
        )
      }
      {
        next && (
          <a href={pageUrl(next)} class="rounded-lg border border-line p-4 text-end no-underline hover:border-brand-600 sm:col-start-2" rel="next">
            <span class="block text-sm text-muted">{m.health.next}</span>
            <span class="font-semibold">{next.data.title}</span>
          </a>
        )
      }
    </nav>
  </article>
</BaseLayout>
