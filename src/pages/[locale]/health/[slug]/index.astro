---
import { render } from 'astro:content';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import CitedText from '../../../../components/CitedText.astro';
import PageCorrections from '../../../../components/PageCorrections.astro';
import Icon from '../../../../components/Icon.astro';
import JsonLd from '../../../../components/JsonLd.astro';
import ShareLinks from '../../../../components/ShareLinks.astro';
import SourceList from '../../../../components/SourceList.astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import type { SourceId } from '../../../../data/sources';
import { SITE_URL } from '../../../../config';
import { format, formatDate, getMessages, LOCALES, localePath } from '../../../../i18n';
import { healthIcon } from '../../../../lib/health-icons';
import { article } from '../../../../lib/structured-data';
import { getAllHealthPages, getHealthPages, isDraft, splitHealthId, type HealthEntry } from '../../../../lib/health';

export async function getStaticPaths() {
  const entries = await getAllHealthPages();
  return entries.map((entry) => {
    const { locale, slug } = splitHealthId(entry.id);
    return { params: { locale, slug }, props: { entry } };
  });
}

interface Props {
  entry: HealthEntry;
}
const { entry } = Astro.props;
const { locale, slug } = splitHealthId(entry.id);
const m = getMessages(locale);
const { Content } = await render(entry);

const siblings = await getHealthPages(locale);
const index = siblings.findIndex((page) => splitHealthId(page.id).slug === slug);
const prev = siblings[index - 1];
const next = siblings[index + 1];
const pageUrl = (page: HealthEntry) => localePath(locale, `/health/${splitHealthId(page.id).slug}/`);
const reviewed = entry.data.reviewed.toISOString().slice(0, 10);
---
<BaseLayout locale={locale} title={entry.data.metaTitle ?? entry.data.title} description={entry.data.description} noindex={isDraft(entry)}>
  <div slot="intro" class="prose-page">
    {
      isDraft(entry) && (
        <p class="mb-4 rounded-lg bg-notice-50 px-4 py-2 font-bold text-notice-900" data-draft-banner lang="en" dir="ltr">
          DRAFT waiting for approval: this page is not on the live site.
        </p>
      )
    }
    <Breadcrumbs
      locale={locale}
      items={[
        { label: m.nav.home, href: localePath(locale) },
        { label: m.health.hubTitle, href: localePath(locale, '/health/') },
        { label: entry.data.title },
      ]}
    />
    <h1 class="page-title">{entry.data.title}</h1>
    <p class="mt-3 flex items-center gap-2 text-sm text-muted">
      <Icon name="circle-check" size={16} class="text-teal-700" />
      <time datetime={reviewed}>{format(m.health.reviewed, { date: formatDate(locale, reviewed) })}</time>
    </p>
  </div>

  <div class="gap-10 lg:grid lg:grid-cols-[minmax(0,46rem)_minmax(0,1fr)]">
    <article class="paper prose-page" data-print-main>
      {
        entry.data.keyPoints.length > 0 && (
          <section aria-labelledby="key-points" class="mb-8 rounded-xl border border-teal-100 bg-teal-50 p-5" data-key-points>
            <h2 id="key-points" class="!mt-0 !mb-3 !text-lg">{m.health.keyPoints}</h2>
            <ul class="check-list">
              {entry.data.keyPoints.map((point) => <li><CitedText text={point} sources={entry.data.sources} locale={locale} /></li>)}
            </ul>
          </section>
        )
      }

      <div class="prose-content">
        <Content />
      </div>

      <p class="note mt-8" data-medical-disclaimer>{m.health.disclaimer}</p>

      <SourceList locale={locale} ids={entry.data.sources as SourceId[]} />

      <PageCorrections locale={locale} corrections={entry.data.corrections} />

      <nav aria-label={`${m.health.previous} / ${m.health.next}`} class="no-print mt-10 grid gap-3 sm:grid-cols-2">
        {
          prev && (
            <a href={pageUrl(prev)} class="card p-4" rel="prev">
              <span class="flex items-center gap-1 text-sm text-muted"><Icon name="arrow-right" size={14} class="-scale-x-100 rtl:scale-x-100" />{m.health.previous}</span>
              <span class="card-title mt-1 block">{prev.data.title}</span>
            </a>
          )
        }
        {
          next && (
            <a href={pageUrl(next)} class="card p-4 text-end sm:col-start-2" rel="next">
              <span class="flex items-center justify-end gap-1 text-sm text-muted">{m.health.next}<Icon name="arrow-right" size={14} flip /></span>
              <span class="card-title mt-1 block">{next.data.title}</span>
            </a>
          )
        }
      </nav>
    </article>

    <aside class="no-print space-y-6 max-lg:mt-10">
      <div class="space-y-6 lg:sticky lg:top-6">
        <div class="card p-5">
          <ShareLinks locale={locale} title={entry.data.title} />
        </div>
        <nav aria-label={m.health.hubTitle} class="card p-3" data-health-nav>
          <h2 class="eyebrow px-3 pt-2">{m.health.hubTitle}</h2>
          <ul class="mt-2">
            {
              siblings.map((page) => {
                const pageSlug = splitHealthId(page.id).slug;
                const active = pageSlug === slug;
                return (
                  <li>
                    <a
                      href={pageUrl(page)}
                      aria-current={active ? 'page' : undefined}
                      class:list={[
                        'flex min-h-11 items-center gap-3 rounded-lg px-3 py-2 text-[0.9375rem] leading-snug no-underline',
                        active ? 'bg-teal-50 font-bold text-brand-950' : 'text-ink hover:bg-surface',
                      ]}
                    >
                      <Icon name={healthIcon(pageSlug)} size={18} class={active ? 'text-teal-700' : 'text-muted'} />
                      {page.data.title}
                    </a>
                  </li>
                );
              })
            }
          </ul>
        </nav>
      </div>
    </aside>
  </div>
  <JsonLd
    data={article({
      type: 'MedicalWebPage',
      url: new URL(Astro.url.pathname, SITE_URL).href,
      title: entry.data.title,
      description: entry.data.description,
      language: LOCALES[locale].htmlLang,
      image: new URL(`/social/${locale}.png`, SITE_URL).href,
      modified: reviewed,
    })}
  />
</BaseLayout>
