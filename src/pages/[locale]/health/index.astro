---
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import Icon from '../../../components/Icon.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getMessages, LOCALE_CODES, localePath, type Locale } from '../../../i18n';
import { getHealthPages, splitHealthId } from '../../../lib/health';
import { healthIcon } from '../../../lib/health-icons';

export function getStaticPaths() {
  return LOCALE_CODES.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const m = getMessages(locale);
const pages = await getHealthPages(locale);
---
<BaseLayout locale={locale} title={m.health.hubTitle} description={m.health.hubDescription}>
  <div slot="intro" class="prose-page">
    <Breadcrumbs locale={locale} items={[{ label: m.nav.home, href: localePath(locale) }, { label: m.health.hubTitle }]} />
    <h1 class="page-title">{m.health.hubTitle}</h1>
    <p class="page-lead">{m.health.hubIntro}</p>
  </div>

  <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3" data-health-list>
    {
      pages.map((page) => {
        const slug = splitHealthId(page.id).slug;
        return (
          <li>
            <a href={localePath(locale, `/health/${slug}/`)} class="card flex h-full flex-col gap-3 p-5">
              <span class="icon-chip"><Icon name={healthIcon(slug)} size={22} /></span>
              <span class="card-title block text-lg leading-snug">{page.data.title}</span>
              <span class="block text-[0.9375rem] text-muted">{page.data.description}</span>
            </a>
          </li>
        );
      })
    }
  </ul>

  <p class="note mt-8 max-w-[44rem]">{m.health.disclaimer}</p>
</BaseLayout>
