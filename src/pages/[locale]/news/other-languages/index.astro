---
import AdSlot from '../../../../components/AdSlot.astro';
import NativeAd from '../../../../components/NativeAd.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import NewsCard from '../../../../components/NewsCard.astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { NEWS, otherLanguageNews } from '../../../../data/news';
import { format, formatDateTime, getMessages, LOCALE_CODES, LOCALES, localePath, type Locale } from '../../../../i18n';
import { languageName } from '../../../../i18n/countries';

export function getStaticPaths() {
  return LOCALE_CODES.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const m = getMessages(locale);
const groups = otherLanguageNews(locale).map((group) => ({ ...group, items: group.items.slice(0, 15) }));
---
<BaseLayout locale={locale} title={m.news.otherLanguages} description={m.news.otherLanguagesDescription} noindex>
  <div slot="intro" class="prose-page">
    <Breadcrumbs
      locale={locale}
      items={[
        { label: m.nav.home, href: localePath(locale) },
        { label: m.news.title, href: localePath(locale, '/news/') },
        { label: m.news.otherLanguages },
      ]}
    />
    <h1 class="text-2xl font-bold text-brand-900 sm:text-3xl">{m.news.otherLanguages}</h1>
    <p class="mt-3 text-lg text-muted">{m.news.otherLanguagesIntro}</p>
    <p class="mt-2 text-sm text-muted">
      <time datetime={NEWS.updatedAt}>{format(m.news.updated, { date: formatDateTime(locale, new Date(NEWS.updatedAt)) })}</time>
    </p>
  </div>

  <nav aria-label={m.news.otherLanguages} class="mb-8">
    <ul class="flex flex-wrap gap-2">
      {
        groups.map((group) => (
          <li>
            <a href={`#lang-${group.lang}`} class="inline-flex min-h-11 items-center rounded-full border border-brand-200 px-4 no-underline hover:bg-brand-50">
              {languageName(locale, group.lang)} ({group.items.length})
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  {
    groups.map((group, index) => (
      <>
      <section id={`lang-${group.lang}`} aria-labelledby={`lang-${group.lang}-title`} class="mb-10" data-language-section={group.lang}>
        <h2 id={`lang-${group.lang}-title`} class="text-xl font-bold text-brand-900">
          {languageName(locale, group.lang)}{' '}
          <span class="font-normal text-muted" lang={LOCALES[group.lang].htmlLang}>({LOCALES[group.lang].nativeName})</span>
        </h2>
        <ul class="mt-4 grid gap-3 lg:grid-cols-2">
          {group.items.map((item) => <li><NewsCard item={item} locale={locale} /></li>)}
        </ul>
      </section>
      {index === 0 && <NativeAd locale={locale} />}
      </>
    ))
  }

  <AdSlot locale={locale} />
  <p class="max-w-[44rem] text-sm text-muted">{m.news.policy}</p>
</BaseLayout>
