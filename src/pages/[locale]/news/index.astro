---
import AdSlot from '../../../components/AdSlot.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import NewsCard from '../../../components/NewsCard.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { NEWS, mediaCoverage, officialUpdates, otherLanguageNews } from '../../../data/news';
import { format, formatDateTime, getMessages, LOCALE_CODES, localePath, type Locale } from '../../../i18n';

export function getStaticPaths() {
  return LOCALE_CODES.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const m = getMessages(locale);
const official = officialUpdates(locale).slice(0, 20);
const media = mediaCoverage(locale).slice(0, 30);
const otherCount = otherLanguageNews(locale).reduce((sum, group) => sum + group.items.length, 0);
---
<BaseLayout locale={locale} title={m.news.title} description={m.news.description} noindex>
  <div slot="intro" class="prose-page">
    <Breadcrumbs locale={locale} items={[{ label: m.nav.home, href: localePath(locale) }, { label: m.news.title }]} />
    <h1 class="text-2xl font-bold text-brand-900 sm:text-3xl">{m.news.title}</h1>
    <p class="mt-3 text-lg text-muted">{m.news.intro}</p>
    <p class="mt-2 text-sm text-muted" data-news-updated>
      <time datetime={NEWS.updatedAt}>{format(m.news.updated, { date: formatDateTime(locale, new Date(NEWS.updatedAt)) })}</time>
    </p>
    <p class="mt-3"><a href={localePath(locale, '/updates/')} class="font-semibold" data-updates-link>{m.updates.latest}</a></p>
  </div>

  <div class="grid gap-10 lg:grid-cols-2">
    <section aria-labelledby="official-title" data-section="official">
      <h2 id="official-title" class="text-xl font-bold text-brand-900">{m.news.official}</h2>
      <ul class="mt-4 space-y-3">
        {official.map((item) => <li><NewsCard item={item} locale={locale} /></li>)}
      </ul>
    </section>

    <section aria-labelledby="media-title" data-section="media">
      <h2 id="media-title" class="text-xl font-bold text-brand-900">{m.news.media}</h2>
      {
        media.length > 0 ? (
          <ul class="mt-4 space-y-3">
            {media.map((item) => <li><NewsCard item={item} locale={locale} /></li>)}
          </ul>
        ) : (
          <p class="mt-4 text-muted">{m.news.mediaEmpty}</p>
        )
      }
    </section>
  </div>

  <AdSlot locale={locale} />
  {
    otherCount > 0 && (
      <p class="mt-10">
        <a href={localePath(locale, '/news/other-languages/')} class="inline-flex min-h-11 items-center rounded-lg border border-brand-200 bg-brand-50 px-4 py-2 font-semibold" data-other-languages-link>
          {format(m.news.otherLanguagesLink, { count: otherCount })}
        </a>
      </p>
    )
  }

  <p class="mt-8 max-w-[44rem] text-sm text-muted">{m.news.policy}</p>
</BaseLayout>
