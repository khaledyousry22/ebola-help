---
import NeutralLayout from '../layouts/NeutralLayout.astro';
import { getMessages, LOCALE_LIST, localePath } from '../i18n';

const en = getMessages('en');
---
<NeutralLayout title={`${en.meta.notFoundTitle} · ${en.meta.siteName}`} description={en.notFound.text} noindex>
  <h1 class="page-title">{en.notFound.heading}</h1>
  <ul class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
    {
      LOCALE_LIST.map((l) => {
        const m = getMessages(l.code);
        return (
          <li lang={l.htmlLang} dir={l.dir} class="card p-5 text-start">
            <p class="font-semibold text-ink">{m.notFound.text}</p>
            <a href={localePath(l.code)} hreflang={l.htmlLang} class="link-arrow mt-1">
              {m.notFound.back}
            </a>
          </li>
        );
      })
    }
  </ul>
</NeutralLayout>
