---
/**
 * Layout for pages that are not in one language yet: the language picker at /
 * and the "page not found" page. Text is shown in all six languages, each
 * marked with its own lang and dir so screen readers pronounce it correctly.
 */
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import LocaleScript from '../components/LocaleScript.astro';
import { SITE_URL } from '../config';
import { getMessages, LOCALE_LIST, localePath } from '../i18n';

interface Props {
  title: string;
  description: string;
  /** Add hreflang links to every language home page (only on /). */
  alternates?: boolean;
  noindex?: boolean;
}
const { title, description, alternates = false, noindex = false } = Astro.props;
---
<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {
      alternates && (
        <>
          <link rel="canonical" href={new URL('/', SITE_URL).href} />
          {LOCALE_LIST.map((l) => (
            <link rel="alternate" hreflang={l.htmlLang} href={new URL(localePath(l.code), SITE_URL).href} />
          ))}
          <link rel="alternate" hreflang="x-default" href={new URL('/', SITE_URL).href} />
        </>
      )
    }
    <meta name="theme-color" content="#155a8a" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col bg-surface">
    <header class="border-b border-line bg-white">
      <div class="container-page py-4">
        <Logo size={36} />
      </div>
    </header>
    <main id="main" class="container-page flex-1 py-8">
      <slot />
    </main>
    <footer class="border-t border-line bg-white py-6 text-sm text-muted">
      <ul class="container-page space-y-2" data-disclaimer>
        {
          LOCALE_LIST.map((l) => (
            <li lang={l.htmlLang} dir={l.dir} class="text-start">
              {getMessages(l.code).footer.disclaimer}
            </li>
          ))
        }
      </ul>
    </footer>
    <LocaleScript />
  </body>
</html>
