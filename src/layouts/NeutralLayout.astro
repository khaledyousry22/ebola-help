---
/**
 * Layout for pages that are not in one language yet: the language picker at /
 * and the "page not found" page. Text is shown in all six languages, each
 * marked with its own lang and dir so screen readers pronounce it correctly.
 */
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import LocaleScript from '../components/LocaleScript.astro';
import { ADS, PATREON_URL, SITE_URL } from '../config';
import Icon from '../components/Icon.astro';
import { alternates as languageLinks } from '../lib/alternates';
import { getMessages, LOCALE_LIST, localePath } from '../i18n';

interface Props {
  title: string;
  description: string;
  /** Add hreflang links to every language home page (only on /). */
  alternates?: boolean;
  noindex?: boolean;
}
const { title, description, alternates = false, noindex = false } = Astro.props;
---
<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {
      alternates && (
        <>
          <link rel="canonical" href={new URL('/', SITE_URL).href} />
          {languageLinks('/').map((link) => <link rel="alternate" hreflang={link.hreflang} href={link.href} />)}
        </>
      )
    }
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Ebola.help" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL('/social/default.png', SITE_URL).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={LOCALE_LIST.map((l) => getMessages(l.code).meta.tagline).join(' · ')} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#0a2740" />
    {ADS.enabled && <meta name="google-adsense-account" content={ADS.client} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col">
    <header class="page-head page-head-hero">
      <div class="container-page py-6 sm:py-8">
        <Logo size={40} light />
        <slot name="band" />
      </div>
    </header>
    <main id="main" class="container-page flex-1 py-8 sm:py-10">
      <slot />
    </main>
    <footer class="site-footer mt-10 bg-brand-950 py-8 text-sm text-[#c9d9e6]">
      <ul class="container-page space-y-2" data-disclaimer>
        {
          LOCALE_LIST.map((l) => (
            <li lang={l.htmlLang} dir={l.dir} class="text-start">
              {getMessages(l.code).footer.disclaimer}
            </li>
          ))
        }
      </ul>
      <ul class="container-page mt-5 flex flex-wrap gap-x-5 gap-y-1 border-t border-white/15 pt-4" data-privacy-links>
        {
          LOCALE_LIST.map((l) => (
            <li lang={l.htmlLang} dir={l.dir}>
              <a href={localePath(l.code, '/privacy/')} hreflang={l.htmlLang} class="footer-link">{getMessages(l.code).footer.privacy}</a>
            </li>
          ))
        }
      </ul>
      <div class="container-page mt-5 flex flex-wrap items-center gap-x-5 gap-y-2 border-t border-white/15 pt-4" data-support>
        <Icon name="heart" size={18} class="text-white" />
        <ul class="flex flex-wrap gap-x-5 gap-y-1">
          {
            LOCALE_LIST.map((l) => (
              <li lang={l.htmlLang} dir={l.dir}>
                <a href={PATREON_URL} class="footer-link" data-support-link>{getMessages(l.code).about.supportTitle}</a>
              </li>
            ))
          }
        </ul>
      </div>
    </footer>
    <LocaleScript />
  </body>
</html>
